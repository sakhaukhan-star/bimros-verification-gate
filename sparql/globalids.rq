PREFIX ifc:  <http://standards.buildingsmart.org/IFC/DEV/IFC2x3/TC1/OWL#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?element ?globalIdEntity ?globalIdValue
WHERE {
  { ?element rdf:type ifc:IfcWallStandardCase } UNION { ?element rdf:type ifc:IfcOpeningElement }
  ?element ifc:globalId_IfcRoot ?globalIdEntity .
  ?globalIdEntity ?p ?globalIdValue .
}
ORDER BY ?element
